    },
    {
      "name": "Local diff before bulk write",
      "command": "records diff",
      "description": "See exactly which fields on which existing records would change before a bulk update or upsert actually runs."
    },
    {
      "name": "Cross-base full-text search",
      "command": "search",
      "description": "Search text across every synced base and table at once from one local index."
    },
    {
      "name": "Schema drift detection",
      "command": "bases schema-diff",
      "description": "Show exactly what changed in a base's schema since the last time this command ran for that base."
    }
